# ==============================================================================
# VARIABLES DE ENTORNO EXCLUSIVAS DE CLÍNICA CABAL SALUD (cabalsalud.cl)
# Arquitectura: Direct Merchant Routing (Sin intermediación financiera de Gentia)
# ==============================================================================

# URL pública oficial del sitio de Cabal Salud
SITE_BASE_URL=https://cabalsalud.cl
PORT=3001

# 1. CREDENCIALES EXCLUSIVAS TRANSBANK WEBPAY PLUS DE CABAL SALUD
# En integración usar: 597055555532 y llave de pruebas oficial de Transbank.
# En producción usar el código de comercio propio de Cabal Salud SpA.
CABAL_TBK_ENV=INTEGRATION
CABAL_TBK_COMMERCE_CODE=597055555532
CABAL_TBK_API_KEY_SECRET=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# 2. CREDENCIALES EXCLUSIVAS MERCADO PAGO CHILE DE CABAL SALUD
# Comisión referencial Mercado Pago Chile: 3,19% + IVA (abono directo a cuenta MP Cabal Salud)
CABAL_MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
CABAL_MP_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
CABAL_MP_WEBHOOK_SECRET=tu_webhook_secret_mercadopago_cabal

# 3. ACOPLAMIENTO HEADLESS CON MOTOR CLÍNICO GENTIA (gentia.cl)
# Gentia gestiona disponibilidad, bloqueo TTL 15m, sala WebRTC, correos y reporte de liquidación
GENTIA_API_BASE_URL=https://gentia.cl/api
GENTIA_CLINICA_ID=cabalsalud
GENTIA_WEBHOOK_HMAC_SECRET=cabal_gentia_hmac_secret_2026
